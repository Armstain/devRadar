# Copy to .env.local and fill in. Never commit real values.

# App URL used to build OAuth callback URLs (defaults to the request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# MongoDB connection string (server-only; replaces NEXT_PUBLIC_MONGODB_URI)
MONGODB_URI=

# Encrypts stored GitHub/LinkedIn tokens. 32 random bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth app; callback: <APP_URL>/api/auth/github/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# LinkedIn app; callback: <APP_URL>/api/auth/linkedin/callback
NEXT_PUBLIC_LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=

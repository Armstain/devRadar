# Copy to .env.local and fill in. Never commit real values.

# App URL used to build OAuth callback URLs (defaults to the request origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Webhooks → add an endpoint for <APP_URL>/api/webhooks/clerk with the
# user.deleted event, then paste its signing secret here
CLERK_WEBHOOK_SIGNING_SECRET=

# Postgres (https://neon.tech). Use the pooled connection string; run
# `npm run db:migrate` once (with the direct, non-pooled string) to create tables.
DATABASE_URL=

# Upstash Redis (https://console.upstash.com) for rate limiting. Optional
# locally: without it, limits are kept in memory per process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Inngest (https://app.inngest.com) for background jobs. Production needs both
# keys. Locally, set INNGEST_DEV=1 and run `npm run inngest:dev` alongside
# `npm run dev` instead.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=

# Encrypts stored GitHub tokens. 32 random bytes, base64-encoded:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth app; callback: <APP_URL>/api/auth/github/callback
NEXT_PUBLIC_GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Token for the public "scan any username" page. A fine-grained personal
# access token with no permissions is enough (public data only). Without it,
# scans only serve cached results.
GITHUB_SCAN_TOKEN=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional, defaults to gemini-2.5-flash
GEMINI_MODEL=

# Optional: debug | info | warn | error (default: info in production)
LOG_LEVEL=
